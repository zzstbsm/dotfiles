{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,

  /* === Modules Order === */
  "modules-left": [
    "custom/archicon",
    "clock",
    "custom/cpu",
    "custom/temperature-cpu",
    "memory",
    "custom/temperature-gpu",
  ],

  "modules-center": [
  ],

  "modules-right": [
    "privacy",
    "custom/spotify",
    "image#spotify-art",
    "pulseaudio"
  ],

  /* -- Modules on the left --*/
  "custom/archicon": {
    "format": "",
    "on-click": "$HOME/.local/bin/scripts/open-script-menu",
    "tooltip": false
  },
  "clock": {
    "timezone": "Europe/Rome",
    "format": "{:%H:%M  %d %h %y}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month"
    }
  },
  "custom/cpu": {
    "exec": "$HOME/.config/waybar/scripts/hardware_usage cpu-usage",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "format": "{text} ",
  },
  "custom/temperature-cpu": {
    "exec": "$HOME/.config/waybar/scripts/hardware_usage cpu-temperature",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "format": "{text} ",
  },
  "memory": {
    "format": "{used}/{total} GB ",
    "tooltip": true,
    "tooltip-format": "RAM Usage: {used} / {total} ({percentage}%)"
  },
  "custom/temperature-gpu": {
    "exec": "$HOME/.config/waybar/scripts/hardware_usage gpu-temperature",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "format": "{text} ",
  },

  /* -- Modules on the right --*/
  "image#spotify-art": {
    "exec": "$HOME/.config/waybar/scripts/spotify image",
    "size": 24,
    "interval": 1
  },
  "custom/spotify": {
    "exec": "$HOME/.config/waybar/scripts/spotify show",
    "return-type": "json",
    "interval": 1,
    "tooltip": true,
    "format": "{icon}{text}",
    "format-icons": {
      "paused": "󰐊 ",
      "playing": "󰏤 ",
      "standby": "󰓇",
    },
    "on-click": "$HOME/.config/waybar/scripts/spotify click"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "",
        ""
      ]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
  },
  "privacy": {
    "icon-spacing": 3,
    "icon-size": 16,
    "transition-duration": 250,
    "modules": [
      {
        "type": "screenshare",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-out",
        "tooltip": true,
        "tooltip-icon-size": 24
      },
      {
        "type": "audio-in",
        "tooltip": true,
        "tooltip-icon-size": 24
      }
    ],
  }
}
