#!/bin/bash

PLAYER_NAME=spotify
PLAYING_STATUS=$(playerctl --player="$PLAYER_NAME" status)

ALBUM_ART=$(playerctl --player="$PLAYER_NAME" metadata mpris:artUrl)
TRACK_ID=$(playerctl --player="$PLAYER_NAME" metadata mpris:trackid)

CUSTOM_WAYBAR_TMP="/tmp/waybar"

show() {

    if [ ! -z $(echo "$TRACK_ID" | grep "track") ]; then
        TEXT=$(playerctl --player="$PLAYER_NAME" metadata --format "{{ trunc(title,20) }} - {{ trunc(artist,20) }}")
        TOOLTIP=$(
            playerctl --player="$PLAYER_NAME" \
            metadata --format 'Title:`{{title}}\nArtist:`{{artist}}\nAlbum:`{{album}}' \
            | column -t -s '`'
        )
    else
        TEXT=$(playerctl --player="$PLAYER_NAME" metadata --format "{{ trunc(album,20) }} - {{ trunc(title,20) }}")
        TOOLTIP=$(
            playerctl --player="$PLAYER_NAME" \
            metadata --format 'Title:`{{title}}\nSeries:`{{album}}' \
            | column -t -s '`'
        )
    fi

    ALT=standby

    case "$PLAYING_STATUS" in
        "Playing") ALT=playing
        ;;
        "Paused") ALT=paused
        ;;
        *) TEXT="" && TOOLTIP="Start Spotify"
        ;;
    esac

    echo $(jq -Rnc \
        --arg text "$TEXT" \
        --arg tooltip "$TOOLTIP" \
        --arg alt "$ALT" \
        '{text: $text, tooltip: $tooltip, alt: $alt}'
    )
}

image() {
    
    SPOTIFY_COVER_PATH="$CUSTOM_WAYBAR_TMP/spotify-album-cover.jpeg"
    SPOTIFY_TRACK_PATH="$CUSTOM_WAYBAR_TMP/spotify-song"

    # If spotify is off, remove the temp files if it exist and exit
    if [ -z "$PLAYING_STATUS" ]; then
        [ -f "$SPOTIFY_TRACK_PATH" ] && rm "$SPOTIFY_TRACK_PATH"
        [ -f "$SPOTIFY_COVER_PATH" ] && rm "$SPOTIFY_COVER_PATH"
        exit 0
    fi

    mkdir -p "$CUSTOM_WAYBAR_TMP"

    # Check if song file had been saved
    [ ! -f "$SPOTIFY_TRACK_PATH" ] && touch "$SPOTIFY_TRACK_PATH"

    SPOTIFY_CURRENT_TRACK=$(
        playerctl --player="$PLAYER_NAME" \
            metadata --format "{{title}}@{{album}}@{{artist}}"
    )
    SPOTIFY_SAVED_TRACK=$(cat "$SPOTIFY_TRACK_PATH")

    # Download new thumbnail if the track changes or if it does not exist
    if [ "$SPOTIFY_CURRENT_TRACK" != "$SPOTIFY_SAVED_TRACK" ] || [ ! -f "$SPOTIFY_COVER_PATH" ]; then
        curl -s "$ALBUM_ART" -o "$SPOTIFY_COVER_PATH"
        echo "$SPOTIFY_CURRENT_TRACK" > $SPOTIFY_TRACK_PATH
    fi

    echo "$SPOTIFY_COVER_PATH"
}

on_click() {
    case "$PLAYING_STATUS" in
        # Toggle spotify play
        "Playing"|"Paused") playerctl --player=$PLAYER_NAME play-pause
        ;;
        # Open spotify detached from waybar
        *) systemd-run --user --scope --quiet spotify &
        ;;
    esac
    
}

case "$1" in
    "show") show
    ;;
    "click") on_click
    ;;
    "image") image
    ;;
    *) echo ""
    ;;
esac

